# 17/08: dentro do sandbox do Claude Code estes nomes existem na pasta como
# dispositivos de caractere (/dev/null montado por cima), e apareciam como
# arquivo novo no `git status`. Um `git add -A` distraido levaria lixo para o
# repositorio publico. Nao sao arquivos do projeto e nunca serao.
.bash_profile
.bashrc
.gitconfig
.gitmodules
.profile
.ripgreprc
.zprofile
.zshrc
# sem barra no fim: aqui dentro `.idea` e `.vscode` NÃO são pastas, são
# dispositivos de caractere, e `.idea/` não casava com eles
.idea
.vscode
.mcp.json

# resto de script que reescreve documento em lote
*.md.bak

# fila de ideias a processar na proxima sessao: estado de trabalho, nao historico
docs/.ideias-pendentes.json

# recados entre rotas: estado efemero do hook, nao e historico
docs/.recados.json

# 20/08: rascunho e sondagem do processo de trabalho, nao do projeto.
# O repositorio e PUBLICO, e os arquivos de sondagem da VPS carregam saida
# crua de comando (caminho de credencial, variavel de ambiente). Nada disso
# tem por que ser lido por quem chega de fora.
temp.js
test.js
vps_logs/
vps_nuances.*
vps_prompts.*

# capturas de tela da revisao de design: 67 imagens que provam entrega e
